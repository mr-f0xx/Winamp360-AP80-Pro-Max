# Charger sense + cover-panel swap. Deliberately unlabelled and anchored on the
# art viewport origin so the art's clear-on-hide lands inside the panel.
%V(72,170,216,216,1)%Vf(E2E2E8)%Vb(000000)
%?bp<%Vd(dash)|%Vd(cov)>

# One aligned masthead: time | WINAMP | right-inset battery percentage + icon
%V(12,8,336,42,1)%Vf(E2E2E8)%Vb(28283F)
