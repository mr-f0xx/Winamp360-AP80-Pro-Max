# ---- cover panel: art group (hidden while a charger is attached) ----
%Vl(cov,12,144,336,252,1)%Vf(E2E2E8)%Vb(28283F)
%dr(0,0,-,-,68687D)
%dr(1,1,334,250,39395A)
%dr(2,2,332,248,292941)
%dr(2,2,332,15,14141E)
%dr(58,24,220,220,68687D)
%dr(59,25,218,218,171724)
%Vl(cov,18,145,324,13,5)%Vf(E2E2E8)%Vb(14141E)
%alCOVER ART
# Album art viewport. Viewport coordinates are absolute screen coordinates
# (viewports are flat siblings in Rockbox's parse tree) while %dr is relative to
# the viewport it sits in, so the frame above is 58,24 inside the panel but this
# is the on-screen 72,170 - the frame's interior at 70,168 plus its 2px border.
# Frame is 220x220: 7 px clearance under the caption strip, 6 px below the art.
%Vl(cov,72,170,216,216,1)%Vf(E2E2E8)%Vb(000000)
%Cl(0,0,216,216,c,c)
%?C<%Cd|%xd(n)>

