# WINAMP 360 v1.21 — Winamp Classic-style Now Playing + charge dashboard
# Target: Hidizs AP80 Pro Max, portrait 360x640

%wd
%X(d)

%Fl(2,22-ProFont.fnt)
%Fl(3,16-Adobe-Helvetica-Bold.fnt)
%Fl(4,14-Adobe-Helvetica-Bold.fnt)
