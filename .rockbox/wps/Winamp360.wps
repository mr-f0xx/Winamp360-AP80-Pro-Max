%xl(s,seek_slider.bmp,0,0)
%xl(v,vol_slider.bmp,0,0)
%xl(e,eq_anim.bmp,0,0,11)
%xl(w,winamp_logo.bmp,0,0)

# Winamp-blue chassis with restrained metallic header trim
%V(0,0,360,640,1)%Vf(E2E2E8)%Vb(050509)
