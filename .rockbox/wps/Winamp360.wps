%dr(6,6,348,628,1A1A29)
%dr(7,7,346,626,080810)

# Charger sense + cover-panel swap. Deliberately unlabelled and anchored on the
# art viewport origin so the art's clear-on-hide lands inside the panel.
%V(72,170,216,216,1)%Vf(E2E2E8)%Vb(000000)
%?bp<%Vd(dash)|%Vd(cov)>

# One aligned masthead: time on left | WINAMP logo in middle | right-inset battery percentage + icon
%V(12,8,336,42,1)%Vf(E2E2E8)%Vb(28283F)
%dr(0,0,-,-,68687D)
%dr(1,1,334,40,24243B)
%dr(2,2,332,38,14141E)
%dr(3,3,330,1,68687D)
%dr(3,39,330,1,68687D)
%V(22,21,54,16,3)%Vf(D8D8DF)%Vb(14141E)
%al%?cc<%cH:%cM|--:-->
%V(116,17,103,24,1)%Vf(E2E2E8)%Vb(14141E)
%xd(w)
%V(310,21,28,16,1)%Vf(00FF00)%Vb(050509)
%dr(0,0,25,15,171724)
%dr(2,2,21,11,06060A)
%?if(%bl, >=, 75)<%dr(3,3,3,9,00FF00)%dr(8,3,3,9,00FF00)%dr(13,3,3,9,00FF00)%dr(18,3,3,9,00FF00)|%?if(%bl, >=, 50)<%dr(3,3,3,9,00FF00)%dr(8,3,3,9,00FF00)%dr(13,3,3,9,00FF00)|%?if(%bl, >=, 25)<%dr(3,3,3,9,E7D42F)%dr(8,3,3,9,E7D42F)|%?if(%bl, >, 0)<%dr(3,3,3,9,D7443B)|>>>>
# Bolt keyed on charger-attached, so it stays lit even at 100%.
%?bp<%dr(13,3,2,3,FFBB00)%dr(11,5,4,2,FFBB00)%dr(12,7,2,3,FFBB00)>
%dr(0,0,25,1,D8D8DF)
%dr(0,0,1,15,68687D)
%dr(0,14,25,1,68687D)
%dr(24,0,1,15,39395A)
%dr(25,4,3,7,D8D8DF)
%dr(27,4,1,7,68687D)
%V(262,21,42,16,3)%Vf(00FF00)%Vb(14141E)
%ar%bl%%

# Compact LCD/status window with a clean, separator-free title row
%V(12,53,336,88,1)%Vf(E2E2E8)%Vb(28283F)
%dr(0,0,-,-,68687D)
%dr(1,1,334,86,292941)
# Interior painted in one piece, then the caption strip laid over it. Any gap
# between separate rectangles would show the panel base colour as a stray line.
%dr(2,2,332,84,000000)
%dr(2,2,332,16,14141E)
%V(18,55,168,13,5)%Vf(E2E2E8)%Vb(14141E)
%alNOW PLAYING

%V(19,74,88,27,2)%Vf(00FF00)%Vb(000000)
%ac%pc
%V(19,105,88,14,5)%Vf(55FF35)%Vb(000000)
%ac%?mp<STOP|PLAYING|PAUSED|FFWD|REW|REC|REC PAUSED|FM|FM MUTED>

%V(116,74,224,21,3)%Vf(00FF00)%Vb(000000)
%al%s%?it<%it|%fn>
%V(116,94,224,16,4)%Vf(E6E6EA)%Vb(000000)
%al%?ia<%ia|Unknown Artist>
%V(116,110,224,14,5)%Vf(BFC0CC)%Vb(000000)
%al%?id<%id|No album tag>
%V(116,124,224,13,5)%Vf(E7D42F)%Vb(000000)
%al%fc / %fb kbps / %fk kHz

# ---- cover panel: art group (hidden while a charger is attached) ----
%Vl(cov,12,144,336,252,1)%Vf(E2E2E8)%Vb(28283F)
%dr(0,0,-,-,68687D)
%dr(1,1,334,250,39395A)
%dr(2,2,332,248,292941)
%dr(2,2,332,15,14141E)
%dr(58,24,220,220,68687D)
%dr(59,25,218,218,171724)
%Vl(cov,18,145,324,13,5)%Vf(E2E2E8)%Vb(14141E)
%alCOVER ART
# Album art viewport. Viewport coordinates are absolute screen coordinates
# (viewports are flat siblings in Rockbox's parse tree) while %dr is relative to
# the viewport it sits in, so the frame above is 58,24 inside the panel but this
# is the on-screen 72,170 - the frame's interior at 70,168 plus its 2px border.
# Frame is 220x220: 7 px clearance under the caption strip, 6 px below the art.
%Vl(cov,72,170,216,216,1)%Vf(E2E2E8)%Vb(000000)
%Cl(0,0,216,216,c,c)
%?C<%Cd|%xd(n)>

# Winamp stereo analyser: animated 18-band graphic equalizer
%V(12,399,336,64,1)%Vf(E2E2E8)%Vb(28283F)
%dr(0,0,-,-,68687D)
%dr(1,1,334,62,292941)
%dr(2,2,332,60,171724)
%dr(2,2,332,13,14141E)
%dr(14,24,306,1,202033)
%dr(14,35,306,1,202033)
%dr(14,46,306,1,202033)
%dr(14,60,306,1,38385A)
%V(18,400,190,13,5)%Vf(E2E2E8)%Vb(14141E)
%alSTEREO ANALYSER
%V(250,400,90,13,5)%Vf(5F9FE7)%Vb(14141E)
%arLIVE L/R

# Dynamic EQ visualizer: 10 animated frames cycling during playback, resting baseline when stopped/paused
%?mp<%Vd(eq_idle)|%Vd(eq)|%Vd(eq_idle)|%Vd(eq)|%Vd(eq)|%Vd(eq_idle)|%Vd(eq_idle)|%Vd(eq)|%Vd(eq)>
%Vl(eq,38,414,284,45,1)%Vf(00FF00)%Vb(171724)
%t(0.1)%xd(e,1);%t(0.1)%xd(e,2);%t(0.1)%xd(e,3);%t(0.1)%xd(e,4);%t(0.1)%xd(e,5);%t(0.1)%xd(e,6);%t(0.1)%xd(e,7);%t(0.1)%xd(e,8);%t(0.1)%xd(e,9);%t(0.1)%xd(e,10)
%Vl(eq_idle,38,414,284,45,1)%Vf(00FF00)%Vb(171724)
%xd(e,11)

